TESLAFI_API_KEY=replace-with-your-teslafi-api-key
# Copy your existing OpenWeatherMap API key from MagicMirror config.js.
OPENWEATHER_API_KEY=
WEATHER_CITY=Ames,IA,US
# Google Calendar: Settings > Integrate calendar > Secret address in iCal format.
GOOGLE_CALENDAR_URL=
GOOGLE_CALENDAR_NAME=Family
INCLUDE_US_HOLIDAYS=true
TZ=America/Chicago
# Optional additional calendars: single-quoted JSON array, never put private URLs in browser settings.
# CALENDARS_JSON='[{"name":"School","url":"https://example.org/calendar.ics","color":"#8ecae6"}]'
# Optional replacement RSS sources; HTTPS only. Omit to use the original six sources.
# RSS_FEEDS_JSON='[{"name":"BBC","url":"https://feeds.bbci.co.uk/news/rss.xml"}]'

# Optional: only if your TeslaFi ACCOUNT time zone differs from TZ above.
# TESLAFI_TIMEZONE=America/Chicago
